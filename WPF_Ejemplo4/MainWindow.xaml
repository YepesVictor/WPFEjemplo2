<Window x:Class="WPF_Ejemplo4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Ejemplo4"
        mc:Ignorable="d"
        Title="Stack Panel" Height="450" Width="800">

    <StackPanel Name="Panel" PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown">
        <Button Content="Enviar" Margin="15" Width="150" HorizontalAlignment="Left"></Button>
        <Button Content="Enviar 2" Margin="15" Width="150" HorizontalAlignment="Center" Click="Button_Click"></Button>
        <Button Content="Enviar 3" Margin="15" Width="150" HorizontalAlignment="Right"></Button>
    </StackPanel>
</Window>
