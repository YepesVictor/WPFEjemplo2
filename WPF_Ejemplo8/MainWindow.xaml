<Window x:Class="WPF_Ejemplo8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Ejemplo8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TextBox Name="txtValor" Width="100" Margin="160" Text="{Binding ElementName=sliderValor, Path=Value, Mode=OneTime}"></TextBox>
        <Slider Name="sliderValor" Width="350" Minimum="0" Maximum="100" Value="25"></Slider>
    </StackPanel>
</Window>
